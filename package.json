{
  "name": "diix-whatsapp",
  "version": "2.0.0",
  "description": "API Multi-Tenant para Gestão de WhatsApp com Evolution API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --config=jest.config.cjs",
    "test:unit": "jest --config=jest.config.cjs --testPathPattern='tests/unit'",
    "test:integration": "jest --config=jest.config.cjs --testPathPattern='tests/integration'",
    "test:e2e": "jest --config=jest.config.cjs --testPathPattern='tests/e2e'",
    "test:coverage": "jest --config=jest.config.cjs --coverage",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/seed-admin.js",
    "db:studio": "prisma studio",
    "lint": "eslint src/**/*.js || true"
  },
  "keywords": [
    "whatsapp",
    "api",
    "multi-tenant",
    "evolution-api",
    "rest",
    "nodejs",
    "express",
    "postgresql",
    "redis",
    "jwt"
  ],
  "author": "DiixWhatsapp Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "prisma": "^5.22.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.18.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "babel-jest": "^29.7.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
