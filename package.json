{
  "name": "diix-whatsapp",
  "version": "1.0.0-alpha",
  "description": "Sistema multi-tenant de bot para vendas no WhatsApp usando Evolution API",
  "main": "src/server.js",
  "type": "module",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/seed.js",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "multi-tenant",
    "evolution-api",
    "express",
    "nodejs",
    "sales",
    "ecommerce",
    "api",
    "rest"
  ],
  "author": "DiixWhatsapp Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^4.16.2",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.3",
    "morgan": "^1.11.0",
    "prisma": "^4.16.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14"
  }
}
