// Configuração do Prisma para o projeto DiixWhatsapp
// Banco de dados: PostgreSQL
// Modelo multi-tenant com isolamento lógico
// Versão 2.0 - Com sistema completo de e-commerce, promoções e PIX

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum para Roles (Papéis do Usuário)
enum Role {
  SUPER_ADMIN // Dono da plataforma - acesso total
  TENANT_ADMIN // Dono da loja - acesso ao seu tenant
  ATTENDANT // Atendente - acesso limitado
  VIEWER // Apenas visualização
}

// Enum para Status do Tenant
enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  TRIAL
}

// Enum para Planos
enum PlanType {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// Tipos de Chave PIX
enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

// Tipos de Desconto
enum DiscountType {
  PERCENTAGE
  FIXED
}

// Tipos de Campanha/Promoção
enum CampaignType {
  SITE_WIDE // Toda a loja
  CATEGORY // Categoria específica
  PRODUCT // Produto específico
  CUSTOMER_GROUP // Grupo de clientes
  CUSTOMER_INDIVIDUAL // Cliente específico
}

// Status do Pedido
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// Status do Pagamento
enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
  CHARGEBACK
}

// Método de Pagamento
enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  CASH
  OTHER
}

// Tipo de Endereço
enum AddressType {
  RESIDENTIAL
  COMMERCIAL
  DELIVERY
  BILLING
}

// Status do Carrinho
enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
  EXPIRED
}

// Tenant (Loja/Empresa)
model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  email       String
  phone       String?
  plan        PlanType     @default(FREE)
  status      TenantStatus @default(TRIAL)
  maxAccounts Int          @default(3)
  maxMessages Int          @default(500)
  trialEndsAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relacionamentos
  accounts      WhatsAppAccount[]
  users         User[]
  conversations Conversation[]
  orders        Order[]
  configs       TenantConfig[]
  products      Product[]
  auditLogs     AuditLog[]
  customers     Customer[]
  carts         Cart[]
  campaigns     Campaign[]
  discounts     Discount[]
  pixKeys       PixKey[]
  addresses     Address[]

  @@index([slug])
  @@index([status])
  @@index([plan])
}

// Usuários do sistema (administradores de cada tenant + Super Admin)
model User {
  id        String    @id @default(uuid())
  tenantId  String? // Null para SUPER_ADMIN
  email     String
  password  String
  name      String
  role      Role      @default(VIEWER)
  status    String    @default("active") // active, inactive, blocked
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([email])
  @@index([tenantId])
  @@index([role])
}

// Contas WhatsApp vinculadas a cada tenant
model WhatsAppAccount {
  id             String    @id @default(uuid())
  tenantId       String
  name           String
  instanceId     String    @unique // ID da instância na Evolution API
  phoneNumber    String
  status         String    @default("pending") // pending, connected, disconnected
  webhookUrl     String?
  apiKey         String?
  qrcode         String?
  lastConnection DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  messages Message[]

  @@unique([tenantId, instanceId])
  @@index([tenantId])
  @@index([status])
}

// Mensagens enviadas/recebidas
model Message {
  id             String   @id @default(uuid())
  tenantId       String
  accountId      String
  direction      String // inbound, outbound
  fromNumber     String
  toNumber       String
  content        String
  messageType    String   @default("text") // text, image, video, audio, document, location, contact
  status         String   @default("pending") // pending, sent, delivered, read, failed
  metadata       Json? // Dados adicionais (URLs de mídia, etc)
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account      WhatsAppAccount @relation(fields: [accountId], references: [id])
  conversation Conversation?   @relation(fields: [conversationId], references: [id])

  @@index([tenantId])
  @@index([accountId])
  @@index([conversationId])
  @@index([createdAt])
}

// Conversas (sessões de atendimento)
model Conversation {
  id            String   @id @default(uuid())
  tenantId      String
  accountId     String
  contactNumber String
  contactName   String?
  status        String   @default("open") // open, closed, pending
  stage         String   @default("initial") // initial, qualification, proposal, negotiation, closed
  assignedTo    String? // ID do usuário responsável
  metadata      Json? // Dados da conversa (tags, informações do cliente, etc)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  messages Message[]

  @@index([tenantId])
  @@index([accountId])
  @@index([status])
  @@index([stage])
}

// Pedidos/Vendas gerados pelo bot - HISTÓRICO COMPLETO DE VENDAS
model Order {
  id             String         @id @default(uuid())
  tenantId       String
  conversationId String
  customerId     String?
  customerName   String
  customerPhone  String
  customerEmail  String?
  totalAmount    Decimal        @db.Decimal(10, 2)
  subtotal       Decimal        @db.Decimal(10, 2)
  discountAmount Decimal        @default(0) @db.Decimal(10, 2)
  shippingCost   Decimal        @default(0) @db.Decimal(10, 2)
  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod?
  paymentStatus  PaymentStatus  @default(PENDING)
  pixKeyUsed     String? // Chave PIX usada no pagamento
  pixTxId        String? // Transaction ID do PIX
  notes          String?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relacionamentos
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  customer          Customer?   @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  discount          Discount?   @relation(fields: [discountId], references: [id])
  discountId        String?
  shippingAddress   Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  shippingAddressId String?
  billingAddress    Address?    @relation("BillingAddress", fields: [billingAddressId], references: [id])
  billingAddressId  String?

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([paymentStatus])
}

// Itens do Pedido
model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String
  productName    String
  productSku     String?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  totalPrice     Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  metadata       Json? // Variações do produto, etc
  createdAt      DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// Clientes/Customer - Histórico e Dados
model Customer {
  id             String    @id @default(uuid())
  tenantId       String
  name           String
  phone          String
  email          String?
  document       String? // CPF/CNPJ
  tags           String[] // Tags para segmentação
  notes          String?
  totalSpent     Decimal   @default(0) @db.Decimal(10, 2)
  totalOrders    Int       @default(0)
  lastPurchaseAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relacionamentos
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  orders    Order[]
  carts     Cart[]
  addresses Address[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([email])
  @@index([tags])
}

// Carrinho de Compras - Checkout
model Cart {
  id                 String     @id @default(uuid())
  tenantId           String
  customerId         String?
  sessionId          String // Para carrinhos temporários (não logados)
  status             CartStatus @default(ACTIVE)
  subtotal           Decimal    @default(0) @db.Decimal(10, 2)
  discountAmount     Decimal    @default(0) @db.Decimal(10, 2)
  total              Decimal    @default(0) @db.Decimal(10, 2)
  expiresAt          DateTime?
  convertedToOrderId String?
  metadata           Json? // Dados adicionais
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relacionamentos
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  customer          Customer?  @relation(fields: [customerId], references: [id])
  items             CartItem[]
  appliedDiscount   Discount?  @relation(fields: [appliedDiscountId], references: [id])
  appliedDiscountId String?

  @@index([tenantId])
  @@index([customerId])
  @@index([sessionId])
  @@index([status])
}

// Itens do Carrinho
model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  productId  String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  metadata   Json? // Variações, observações
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@index([productId])
}

// Endereços - Entrega e Cobrança
model Address {
  id           String      @id @default(uuid())
  tenantId     String
  customerId   String? // Null se for endereço genérico do tenant
  type         AddressType @default(RESIDENTIAL)
  label        String? // Apelido (Casa, Trabalho, etc)
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  country      String      @default("Brasil")
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relacionamentos
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  customer       Customer? @relation(fields: [customerId], references: [id])
  shippingOrders Order[]   @relation("ShippingAddress")
  billingOrders  Order[]   @relation("BillingAddress")

  @@index([tenantId])
  @@index([customerId])
  @@index([type])
  @@index([isDefault])
}

// Chaves PIX por Tenant
model PixKey {
  id            String     @id @default(uuid())
  tenantId      String
  keyType       PixKeyType
  keyValue      String
  bankName      String
  bankCode      String?
  accountHolder String
  accountNumber String
  agency        String
  isDefault     Boolean    @default(false)
  active        Boolean    @default(true)
  qrCodeStatic  String? // QR Code estático gerado
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relacionamentos
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, keyValue])
  @@index([tenantId])
  @@index([isDefault])
  @@index([active])
}

// Campanhas e Promoções
model Campaign {
  id                   String       @id @default(uuid())
  tenantId             String
  name                 String
  description          String?
  type                 CampaignType
  discountId           String
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean      @default(true)
  usageLimit           Int? // Limite total de usos
  usageCount           Int          @default(0)
  perCustomerLimit     Int? // Limite por cliente
  minPurchaseAmount    Decimal?     @db.Decimal(10, 2)
  targetCategories     String[] // Categorias alvo (se type=CATEGORY)
  targetProducts       String[] // Produtos alvo (se type=PRODUCT)
  targetCustomerGroups String[] // Grupos de clientes (tags)
  targetCustomers      String[] // Clientes específicos
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relacionamentos
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  discount Discount @relation(fields: [discountId], references: [id])

  @@index([tenantId])
  @@index([type])
  @@index([isActive])
  @@index([startDate, endDate])
}

// Descontos e Cupons
model Discount {
  id                   String       @id @default(uuid())
  tenantId             String
  code                 String // Código do cupom
  description          String?
  type                 DiscountType
  value                Decimal      @db.Decimal(10, 2) // Valor ou porcentagem
  minPurchaseAmount    Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount    Decimal?     @db.Decimal(10, 2)
  usageLimit           Int?
  usageCount           Int          @default(0)
  perCustomerLimit     Int?         @default(1)
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean      @default(true)
  applicableTo         String       @default("all") // all, specific_products, specific_categories
  targetProducts       String[] // IDs dos produtos
  targetCategories     String[] // IDs das categorias
  targetCustomerGroups String[] // Tags de clientes
  autoApply            Boolean      @default(false)
  stackable            Boolean      @default(false) // Pode ser usado com outros
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relacionamentos
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]
  orders    Order[]
  carts     Cart[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([isActive])
  @@index([type])
}

// Produtos/Catálogo por Tenant - ATUALIZADO
model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  sku         String?
  price       Decimal  @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  category    String?
  images      Json? // Array de URLs de imagens
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  metadata    Json? // Dados adicionais (variações, atributos, etc)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([category])
  @@index([active])
  @@index([featured])
}

// Configurações do tenant
model TenantConfig {
  id          String   @id @default(uuid())
  tenantId    String
  key         String
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Logs de auditoria
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@index([userId])
}
