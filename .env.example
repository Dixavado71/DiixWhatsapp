# ===========================================
# Variáveis de Ambiente para Desenvolvimento
# DiixWhatsapp - Sistema Multi-Tenant
# ===========================================

# ===========================================
# SERVIDOR
# ===========================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ===========================================
# BANCO DE DADOS - ESCOLHA UM (PostgreSQL ou MongoDB)
# ===========================================
# Opção 1: PostgreSQL (Recomendado para dados estruturados)
DB_PROVIDER=postgresql
DATABASE_URL="postgresql://user:password@localhost:5432/diix_whatsapp?schema=public"

# Opção 2: MongoDB (Recomendado para flexibilidade e documentos JSON)
# DB_PROVIDER=mongodb
# MONGODB_URI="mongodb://localhost:27017/diix_whatsapp"

# ===========================================
# EVOLUTION API
# ===========================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key_here

# ===========================================
# SEGURANÇA - JWT
# ===========================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ===========================================
# MULTI-TENANT - LIMITES PADRÃO
# ===========================================
DEFAULT_TENANT_LIMIT_ACCOUNTS=5
DEFAULT_TENANT_LIMIT_MESSAGES=1000

# ===========================================
# REDIS - CACHE E FILAS (Opcional)
# ===========================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# WEBHOOK
# ===========================================
WEBHOOK_URL=http://localhost:3000/webhook

# ===========================================
# LOGS
# ===========================================
# Níveis: error, warn, info, debug
LOG_LEVEL=debug

# ===========================================
# UPLOADS
# ===========================================
UPLOAD_DIR=./uploads

# ===========================================
# RATE LIMITING - PROTEÇÃO CONTRA ABUSO
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# CORS - ORIGENS PERMITIDAS
# ===========================================
CORS_ORIGIN=*

# ===========================================
# INSTRUÇÕES DE USO
# ===========================================
# 1. Escolha seu banco de dados:
#    - Para PostgreSQL: mantenha DB_PROVIDER=postgresql e configure DATABASE_URL
#    - Para MongoDB: mude para DB_PROVIDER=mongodb e configure MONGODB_URI
#
# 2. Redis é opcional:
#    - Para desabilitar: REDIS_ENABLED=false
#    - Para habilitar: REDIS_ENABLED=true e configure host/port/password
#
# 3. Em produção, ALTERE TODAS as chaves secretas!
# ===========================================

